# Which agent backend runs backtests.
#   mock  — procedural, in-process, no Docker/Codex needed (default; great for demo/dev)
#   codex — real: spawns a Docker container running `codex exec` (needs Docker daemon up + Codex CLI auth)
HINDSIGHT_AGENT=mock

# Docker image used for real runs (built from ./docker).
HINDSIGHT_DOCKER_IMAGE=hindsight-agent:latest

# Path on the host to mount Codex auth/config into the container (read-only).
HINDSIGHT_CODEX_HOME=~/.codex

# Default model passed to `codex exec -m <model>` inside the container. Only
# used until the in-app settings dialog saves a choice — data/settings.json
# takes precedence once it exists.
HINDSIGHT_CODEX_MODEL=gpt-5.6-sol

# Where session data + per-session workdirs/snapshots live (default: ./data).
HINDSIGHT_DATA_DIR=./data

# Default phone (E.164) that receives buy/sell signal messages when a strategy
# is activated without an explicit number. Set yours in .env.local, not here.
#HINDSIGHT_SIGNAL_PHONE=+15551234567

# How signal messages are delivered.
#   imessage — macOS Messages app via osascript (default). Caveat: sends as the
#              signed-in Apple ID, so messages to your own number land in the
#              self-thread with NO notification; broken outright on macOS 26.
#   signal   — a self-hosted signal-cli-rest-api service; arrives on Signal
#              from a dedicated bot number as a real conversation (recommended)
#   poke     — POST to Poke.com's inbound webhook (needs HINDSIGHT_POKE_API_KEY)
#   webhook  — POST { phone, message } to HINDSIGHT_SIGNAL_WEBHOOK_URL (OpenClaw/Hermes-style bridge)
#HINDSIGHT_SIGNAL_PROVIDER=imessage

# `signal` provider: base URL of your signal-cli-rest-api service (no trailing
# slash needed), the bot's registered number (E.164) it sends from, and an
# optional Authorization header value if the service sits behind a proxy.
#HINDSIGHT_SIGNAL_CLI_URL=https://signal.example.com
#HINDSIGHT_SIGNAL_SENDER=+15551234567
#HINDSIGHT_SIGNAL_CLI_AUTH=

# API key for the `poke` provider.
#HINDSIGHT_POKE_API_KEY=

# Target URL for the `webhook` provider.
#HINDSIGHT_SIGNAL_WEBHOOK_URL=
