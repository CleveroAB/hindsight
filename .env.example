# Which agent backend runs backtests.
#   mock  — procedural, in-process, no Docker/Codex needed (default; great for demo/dev)
#   codex — real: spawns a Docker container running `codex exec` (needs Docker daemon up + Codex CLI auth)
HINDSIGHT_AGENT=mock

# Docker image used for real runs (built from ./docker).
HINDSIGHT_DOCKER_IMAGE=hindsight-agent:latest

# Path on the host to mount Codex auth/config into the container (read-only).
HINDSIGHT_CODEX_HOME=~/.codex

# Default model passed to `codex exec -m <model>` inside the container. Only
# used until the in-app settings dialog saves a choice — data/settings.json
# takes precedence once it exists.
HINDSIGHT_CODEX_MODEL=gpt-5.6-sol

# Where session data + per-session workdirs/snapshots live (default: ./data).
HINDSIGHT_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Public hosting: HTTP Basic auth
# ---------------------------------------------------------------------------
# Leave BOTH unset for normal local use (proxy.ts then keeps its default
# behaviour: the app is open on localhost/LAN, and tunnel traffic can reach
# only the share page).
#
# Set BOTH to lock the app down behind a username + password — required if you
# put Hindsight on a public domain, since anyone who reaches it can otherwise
# spend your Codex credits. Every path is then challenged EXCEPT
# /share/<token>, which stays public so share links keep working for whoever
# you send them to.
#
# Both must be non-empty to take effect; setting only one leaves auth OFF.
# Use a long random password (e.g. `openssl rand -base64 24`) and serve over
# HTTPS — Basic credentials are sent on every request.
# HINDSIGHT_AUTH_USER=carl
# HINDSIGHT_AUTH_PASSWORD=
